+                row.addView(tv(inf.idx.toString(), 13f, V_FG).apply { setPadding(dp(8), 0, dp(8), 0) }, lp(0, WRAP, 1f))
+                row.addView(tv("waktu ${inf.wait}", 12f, V_DIM), lp(WRAP, WRAP))

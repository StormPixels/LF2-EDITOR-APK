+    private fun updateHints() {
+        val f = frame
+        for ((k, v) in hints) {
+            val value = f?.top?.get(k)
+            v.text = if (k == "state") (value?.let { Labels.STATE[it] } ?: "") else Labels.refHint(k, value, infos)

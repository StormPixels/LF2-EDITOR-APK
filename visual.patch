+    private fun boxRow(type: String, i: Int, label: String, o: Sect, sel: com.lf2ide.mobile.Sel?): View {
+        val on = sel != null && sel.type == type && sel.i == i
+        val parts = ArrayList<String>()
+        for (k in listOf("x", "y", "w", "h")) o.v[k]?.let { parts.add("$k $it") }
+        val r = tv(label + "   " + parts.joinToString(" "), 13f, if (on) V_BG else V_FG)
+        r.setPadding(dp(8), dp(8), dp(8), dp(8))
+        r.setBackgroundColor(if (on) V_ACC else V_BG)
+        r.setOnClickListener {
+            canvas.sel = com.lf2ide.mobile.Sel(type, i)
+            canvas.invalidate()
+            buildTab()
+        }
+        val box = LinearLayout(ctx)
+        box.setPadding(0, dp(2), 0, dp(2))
+        box.addView(r, lp(MATCH, WRAP))
+        return box
+    }
+
+    private fun syncBoxFields() {
+        val o = frame?.obj(canvas.sel) ?: return
+        for ((k, et) in boxFields) {
+            if (k == "x" || k == "y") et.setText((o.v[k] ?: 0).toString())
+        }
+    }
+
+    private fun commitBox(key: String, v: String) {
+        val o = frame?.obj(canvas.sel) ?: return
+        val t = v.trim()
+        if (t.isEmpty()) {
+            o.v.remove(key)
+        } else {
+            val n = t.toIntOrNull() ?: return
+            o.v[key] = n
+        }
+        applyFrame()
+        canvas.invalidate()
+    }
+
+    private fun addBox(t: String) {
+        val f = frame ?: return
+        val s = Sect(t)
+        s.v["kind"] = 0
+        s.v["x"] = 20
+        s.v["y"] = 20
+        s.v["w"] = 30
+        s.v["h"] = 30
+        if (t == "itr") s.v["injury"] = 10
+        val l = if (t == "itr") f.itrs else f.bdys
+        l.add(s)
+        canvas.sel = com.lf2ide.mobile.Sel(t, l.size - 1)
+        applyFrame()
+        canvas.invalidate()
+        buildTab()
+    }
+
+    private fun togglePoint(t: String) {
+        val f = frame ?: return
+        if (f.points.containsKey(t)) {
+            f.points.remove(t)
+            if (canvas.sel?.type == t) canvas.sel = null
+        } else {
+            val s = Sect(t)
+            for ((k, _) in Schema.fields[t] ?: emptyList()) s.v[k] = 0
+            if (s.v.containsKey("kind")) s.v["kind"] = 1
+            s.v["x"] = 20
+            s.v["y"] = 20
+            f.points[t] = s
+            canvas.sel = com.lf2ide.mobile.Sel(t, 0)
+        }
+        applyFrame()
+        canvas.invalidate()
+        buildTab()
+    }
+
+    private fun deleteSel() {
+        val f = frame ?: return
+        val s = canvas.sel ?: return
+        when (s.type) {
+            "itr" -> if (s.i < f.itrs.size) f.itrs.removeAt(s.i)
+            "bdy" -> if (s.i < f.bdys.size) f.bdys.removeAt(s.i)
+            else -> f.points.remove(s.type)
+        }
+        canvas.sel = null
+        applyFrame()
+        canvas.invalidate()
+        buildTab()
+    }
+
+    /** Tulis ulang frame aktif dari modelnya (dipakai untuk perubahan kotak/titik). */
+    private fun applyFrame() {
+        val f = frame ?: return
+        val c0 = cur ?: return
+        val t = ed.text.toString()
+        if (c0.e > t.length || !t.startsWith("<frame>", c0.s)) return
+        applying = true
+        try {
+            ed.text.replace(c0.s, c0.e, FrameWriter.frameToString(f))
+            ed.setSelection(minOf(c0.s + 8, ed.text.length))
+        } catch (ex: Exception) {
+        } finally {
+            applying = false
+        }
+        val t2 = ed.text.toString()
+        infos = FrameOps.infos(t2)
+        groups = FrameOps.group(infos)
+        cur = infos.firstOrNull { it.s == c0.s } ?: cur
+        rebuildRows()
+        rebuildStrip()
+    }
+
+    // ---------- tab Gambar ----------
+    private fun buildPicTab() {
+        val pic = frame?.top?.get("pic")
+        form.addView(tv(if (pic != null) "Sprite nomor $pic" else "Frame ini belum punya nomor gambar", 16f, V_FG))
+        val cl = if (pic != null) Sprites.cellFor(sheets, pic) else null
+        val info = if (cl != null) {
+            "Lembar: ${cl.s.name}  (${cl.s.w}×${cl.s.h}, ${cl.s.row}×${cl.s.col})" +
+                if (sprites.has(cl.s.file)) "" else "\nGambar belum dimuat"
+        } else "Lembar untuk nomor ini tidak ditemukan di header"
+        form.addView(tv(info, 13f, V_DIM))
+        val bar = LinearLayout(ctx)
+        bar.addView(sbtn("Pilih sprite…") { pickSprite() }, lp(0, WRAP, 1f))
+        bar.addView(sbtn("Folder game…") { openFolder() }, lp(0, WRAP, 1f))
+        form.addView(bar)
+        if (!folderSet) form.addView(tv("Pilih folder game agar sprite dimuat otomatis dari jalur di header.", 12f, V_DIM))
+        val h = tv("LEMBAR DI HEADER", 13f, V_SEC)
+        h.setPadding(0, dp(10), 0, dp(2))
+        form.addView(h)
+        for (s in sheets) form.addView(tv("${s.start}–${s.end}   ${s.name}   ${s.w}×${s.h}   ${s.row}×${s.col}", 12f, V_FG))
+    }
+
+    // ---------- tab Karakter ----------
+    private fun buildHeadTab() {
+        val hf = FrameOps.headFields(ed.text.toString())
+        if (hf.isEmpty()) {
+            form.addView(tv("Tidak ada data header di file ini.", 13f, V_DIM))
+            return
+        }
+        descTv.text = "Ketuk kolom lalu ubah nilainya"
+        val h = tv("HEADER", 13f, V_SEC)
+        h.setPadding(0, dp(4), 0, dp(2))
+        form.addView(h)
+        for (f in hf) form.addView(headRow(f))
+    }
+
+    private fun headRow(h: HeadField): View {
+        val r = LinearLayout(ctx)
+        r.gravity = Gravity.CENTER_VERTICAL
+        r.setPadding(0, dp(3), 0, dp(3))
+        val name = Labels.headName(h.key)
+        r.addView(tv(name, 12f, V_DIM), lp(0, WRAP, 1f))
+        val et = inputBox(h.value, false, { descTv.text = name + " (" + h.key + ")" }, { v -> commitHead(h.key, v) })
+        r.addView(et, lp(dp(150), WRAP))
+        return r
+    }
+
+    private fun commitHead(key: String, v: String) {
+        val t = v.trim()
+        val f = FrameOps.headFields(ed.text.toString()).firstOrNull { it.key == key } ?: return
+        if (f.value == t) return
+        applying = true
+        try {
+            ed.text.replace(f.s, f.e, t)
+        } catch (ex: Exception) {
+        } finally {
+            applying = false
+        }
+        load(false)
+    }
+
+    // ---------- pratinjau animasi ----------
+    private fun speedText() = "${speeds[speedI]}×".replace(".0×", "×")
+
+    private fun togglePlay() { if (playing) stopPlay() else startPlay() }
+
+    private fun startPlay() {
+        val f = frame
+        if (f == null) return
+        val m = LinkedHashMap<Int, Frame>()
+        for (raw in Tokenizer.getFrames(ed.text.toString())) {
+            val fr = try { FrameParser.read(raw) } catch (ex: Exception) { null } ?: continue
+            if (!m.containsKey(fr.index)) m[fr.index] = fr
+        }
+        if (!m.containsKey(f.index)) m[f.index] = f
+        seq = m
+        startIdx = f.index
+        val chain = ArrayList<Frame>()
+        val seen = HashSet<Int>()
+        var i = startIdx
+        while (true) {
+            val fr = seq[i] ?: break
+            if (!seen.add(i)) break
+            chain.add(fr)
+            val n = fr.top["next"] ?: break
+            if (n >= 999 || (n == 0 && startIdx != 0)) break
+            i = n
+        }
+        playAx = chain.maxOf { it.top["centerx"] ?: 0 }
+        playAy = chain.maxOf { it.top["centery"] ?: 0 }
+        // perkiraan gerak horizontal (dvx x lama frame) bila "dengan gerak" aktif
+        val pm = HashMap<Int, Int>()
+        var px = 0
+        var minPx = 0
+        var maxPx = 0
+        if (moveOn) {
+            for (fr in chain) {
+                pm[fr.index] = px
+                val dv = fr.top["dvx"]
+                if (dv != null && dv > -500 && dv < 500) px += dv * ((fr.top["wait"] ?: 0) + 1)
+                px = px.coerceIn(-300, 300)
+                minPx = minOf(minPx, px)
+                maxPx = maxOf(maxPx, px)
+            }
+        }
+        pxMap = pm
+        playMinPx = minPx
+        var mw = 0
+        var mh = 0
+        for (fr in chain) {
+            val pic = fr.top["pic"] ?: continue
+            val c = Sprites.cellFor(sheets, pic) ?: continue
+            mw = maxOf(mw, playAx - (fr.top["centerx"] ?: 0) + c.s.w)
+            mh = maxOf(mh, playAy - (fr.top["centery"] ?: 0) + c.s.h)
+            if (!sprites.has(c.s.file)) sprites.request(c.s.file) { canvas.invalidate() }
+        }
+        canvas.boxW = maxOf(120, mw + (maxPx - minPx) + 10)
+        canvas.boxH = maxOf(110, mh + 10)
+        canvas.sel = null
+        canvas.ghost = null
+        canvas.requestLayout()
+        playing = true
+        btnPlay?.text = "Stop"
+        curIdx = startIdx
+        playTick()
+    }
+
+    private fun stopPlay() {
+        if (!playing) return
+        playing = false
+        handler.removeCallbacks(playRun)
+        btnPlay?.text = "Putar"
+        canvas.offX = 0
+        canvas.offY = 0
+        canvas.boxW = null
+        canvas.boxH = null
+        load(true)
+    }
+
+    private fun playTick() {
+        if (!playing) return
+        if (!root.isShown) { stopPlay(); return }
+        val fr = seq[curIdx] ?: seq[startIdx]
+        if (fr == null) { stopPlay(); return }
+        val pic = fr.top["pic"]
+        val c = if (pic != null) Sprites.cellFor(sheets, pic) else null
+        canvas.frame = fr
+        canvas.cell = c
+        canvas.bmp = if (c != null) sprites.peek(c.s.file) else null
+        canvas.offX = playAx - (fr.top["centerx"] ?: 0) + ((pxMap[fr.index] ?: 0) - playMinPx)
+        canvas.offY = playAy - (fr.top["centery"] ?: 0)
+        msgTv.text = "▶ ${fr.index} ${fr.caption} · waktu ${fr.top["wait"] ?: 0} · ${speedText()}"
+        canvas.invalidate()
+        val snd = fr.sound
+        if (soundOn && snd != null) playSound(snd)
+        val wait = (fr.top["wait"] ?: 0).coerceIn(0, 999)
+        var ms = ((wait + 1) * 1000f / 30f / speeds[speedI]).toLong().coerceAtLeast(16L)
+        val n = fr.top["next"]
+        if (n == null || n >= 999 || !seq.containsKey(n) || (n == 0 && startIdx != 0)) {
+            curIdx = startIdx
+            ms += 300L // jeda singkat sebelum mengulang
+        } else {
+            curIdx = n
+        }
+        handler.postDelayed(playRun, ms)
+    }
+
+    private fun playSound(path: String) {
+        val fnd = sprites.finder ?: return
+        Thread {
+            try {
+                val bytes = fnd(path) ?: return@Thread
+                val tmp = File(ctx.cacheDir, "snd_" + path.hashCode() + ".wav")
+                if (!tmp.exists()) tmp.writeBytes(bytes)
+                handler.post {
+                    try {
+                        val mp = MediaPlayer()
+                        mp.setDataSource(tmp.absolutePath)
+                        mp.setOnCompletionListener { it.release() }
+                        mp.setOnPreparedListener { it.start() }
+                        mp.prepareAsync()
+                    } catch (ex: Exception) { }
+                }
+            } catch (ex: Exception) { }
+        }.start()
+    }
+}
diff --git a/app/src/main/java/com/lf2ide/mobile/core/FrameOps.kt b/app/src/main/java/com/lf2ide/mobile/core/FrameOps.kt
new file mode 100644
index 0000000..7232643
--- /dev/null
+++ b/app/src/main/java/com/lf2ide/mobile/core/FrameOps.kt
@@ -0,0 +1,236 @@
+package com.lf2ide.mobile.core
+
+/** Satu frame di teks .dat: nomor, posisi awal `<frame>`, dan posisi tepat setelah `<frame_end>`. */
+class FrameRange(val idx: Int, val s: Int, val e: Int)
+
+/** Kepala frame untuk daftar/pencarian: nomor, caption, dan posisi `<frame>`. */
+class FrameHead(val idx: Int, val caption: String, val pos: Int)
+
+/** Ringkasan satu frame untuk daftar visual: field utama dan rentang teksnya. */
+class FrameInfo(val idx: Int, val caption: String, val pic: Int?, val wait: Int, val next: Int?, val s: Int, val e: Int)
+
+/** Frame berurutan dengan nama gerakan yang sama (mis. standing 0-3). */
+class FrameGroup(val key: String, val frames: List<FrameInfo>)
+
+/** Satu baris header karakter (name, head, walking_speed, ...) beserta rentang nilainya di teks. */
+class HeadField(val key: String, val value: String, val s: Int, val e: Int)
+
+/**
+ * Operasi teks pada frame (salin frame, salin/tempel move, hapus, cari).
+ * Bekerja langsung pada teks mentah supaya field yang tidak dikenal parser tidak hilang.
+ */
+object FrameOps {
+    const val MAX_INDEX = 998
+
+    private val HDR = Regex("""<frame>\s+(\d+)""")
+    private val HDR_NAME = Regex("""<frame>\s+(\d+)\s+(\S+)""")
+    private val HDR_SUB = Regex("""^<frame>(\s+)\d+""")
+    private val NEXT = Regex("""(?<![A-Za-z_])next:\s*(\d+)""")
+
+    // field yang berisi nomor frame (tujuan lompatan)
+    private val REF1 = Regex(
+        """(?<![A-Za-z_])(next|hit_a|hit_d|hit_j|hit_Fa|hit_Ua|hit_Da|hit_Fj|hit_Uj|hit_Dj|hit_ja|action|fronthurtact|backhurtact|vaction|aaction|jaction|daction|taction|weaponact):(\s*)(\d+)"""
+    )
+    // itr: dua nomor frame per field
+    private val REF2 = Regex("""(?<![A-Za-z_])(catchingact|caughtact):(\s*)(\d+)(\s+)(\d+)""")
+
+    fun ranges(t: String): List<FrameRange> {
+        val out = ArrayList<FrameRange>()
+        for (m in HDR.findAll(t)) {
+            val idx = m.groupValues[1].toIntOrNull() ?: continue
+            val e = t.indexOf("<frame_end>", m.range.first)
+            if (e < 0) continue
+            out.add(FrameRange(idx, m.range.first, e + 11))
+        }
+        return out
+    }
+
+    fun headers(t: String): List<FrameHead> =
+        HDR_NAME.findAll(t).mapNotNull { m ->
+            val idx = m.groupValues[1].toIntOrNull() ?: return@mapNotNull null
+            FrameHead(idx, m.groupValues[2], m.range.first)
+        }.toList()
+
+    fun indexOf(raw: String): Int? = HDR.find(raw)?.groupValues?.get(1)?.toIntOrNull()
+
+    fun nextOf(raw: String): Int? = NEXT.find(raw)?.groupValues?.get(1)?.toIntOrNull()
+
+    /** Nomor kosong pertama >= from (minimal 1) sampai MAX_INDEX, atau null jika habis. */
+    fun freeFrom(used: Set<Int>, from: Int): Int? {
+        var i = maxOf(1, from)
+        while (i <= MAX_INDEX) {
+            if (i !in used) return i
+            i++
+        }
+        return null
+    }
+
+    fun withIndex(raw: String, ni: Int): String =
+        HDR_SUB.replace(raw) { m -> "<frame>" + m.groupValues[1] + ni }
+
+    private fun mp(s: String, m: Map<Int, Int>): String {
+        val n = s.toIntOrNull() ?: return s
+        val r = if (n != 0) m[n] else null
+        return r?.toString() ?: s
+    }
+
+    /** Ganti tujuan lompatan yang menunjuk ke frame dalam peta (nomor 0 = "tidak ada", tidak diubah). */
+    fun remap(raw: String, m: Map<Int, Int>): String {
+        var r = REF2.replace(raw) { g ->
+            g.groupValues[1] + ":" + g.groupValues[2] + mp(g.groupValues[3], m) + g.groupValues[4] + mp(g.groupValues[5], m)
+        }
+        r = REF1.replace(r) { g -> g.groupValues[1] + ":" + g.groupValues[2] + mp(g.groupValues[3], m) }
+        return r
+    }
+
+    /** Frame-frame sebuah move: mulai dari `start`, ikuti `next` sampai 0, >=999, hilang, atau berulang. */
+    fun chain(t: String, start: Int, limit: Int = 64): List<String> {
+        val byIdx = HashMap<Int, FrameRange>()
+        for (r in ranges(t)) if (!byIdx.containsKey(r.idx)) byIdx[r.idx] = r
+        val out = ArrayList<String>()
+        val seen = HashSet<Int>()
+        var i = start
+        while (out.size < limit) {
+            val r = byIdx[i] ?: break
+            if (!seen.add(i)) break
+            val raw = t.substring(r.s, r.e)
+            out.add(raw)
+            val n = nextOf(raw) ?: break
+            if (n == 0 || n >= 999) break
+            i = n
+        }
+        return out
+    }
+
+    /**
+     * Beri nomor baru (mulai dari `from`, hanya nomor yang belum dipakai) untuk sekelompok frame hasil salinan,
+     * lalu arahkan ulang lompatan antar frame di dalam kelompok itu. Null jika nomor kosong tidak cukup.
+     */
+    fun relocate(raws: List<String>, used: Set<Int>, from: Int): List<String>? {
+        val taken = HashSet(used)
+        val map = LinkedHashMap<Int, Int>()
+        val olds = ArrayList<Int>()
+        var next = from
+        for (raw in raws) {
+            val o = indexOf(raw) ?: return null
+            val ni = freeFrom(taken, next) ?: return null
+            olds.add(o)
+            taken.add(ni)
+            map[o] = ni
+            next = ni + 1
+        }
+        return raws.mapIndexed { k, raw -> remap(withIndex(raw, map.getValue(olds[k])), map) }
+    }
+
+    /** Berapa frame lain (selain yang mulai di `exceptPos`) yang `next`-nya menuju `idx`. */
+    fun referrers(t: String, idx: Int, exceptPos: Int): Int {
+        var n = 0
+        for (r in ranges(t)) {
+            if (r.s == exceptPos) continue
+            val v = nextOf(t.substring(r.s, r.e))
+            if (v == idx) n++
+        }
+        return n
+    }
+
+    /** Hapus frame [s, e) beserta sampai dua pemisah baris setelahnya; kembalikan batas akhir yang dihapus. */
+    fun deleteEnd(t: String, e: Int): Int {
+        var j = e
+        var nl = 0
+        while (j < t.length && nl < 2 && (t[j] == '\n' || t[j] == '\r' || t[j] == ' ' || t[j] == '\t')) {
+            if (t[j] == '\n') nl++
+            j++
+        }
+        return j
+    }
+
+    // ---------- ringkasan, kelompok, dan penyuntingan field ----------
+    private val SECT = Regex("""(?<![A-Za-z_])(bpoint|opoint|cpoint|wpoint|itr|bdy):""")
+    private val HDR_CAP = Regex("""^(<frame>\s+\d+\s+)\S+""")
+    private val GKEY = Regex("""[_\-]?\d+$""")
+    private val HEADRE = Regex("""(?m)^[ \t]*([A-Za-z_][A-Za-z_0-9]*):?[ \t]+([^\r\n]*?)[ \t]*$""")
+    private val KEYRE = HashMap<String, Regex>()
+
+    private fun keyRe(k: String): Regex =
+        KEYRE.getOrPut(k) { Regex("(?<![A-Za-z_])" + Regex.escape(k) + ":(\\s*)(\\S+)") }
+
+    /** Batas akhir bagian field utama frame (sebelum seksi bdy/itr/point pertama atau <frame_end>). */
+    private fun topLimit(raw: String): Int {
+        val endTok = raw.lastIndexOf("<frame_end>")
+        val limit = if (endTok >= 0) endTok else raw.length
+        val m = SECT.find(raw)
+        return if (m != null) minOf(limit, m.range.first) else limit
+    }
+
+    fun intIn(raw: String, key: String): Int? =
+        keyRe(key).find(raw.substring(0, topLimit(raw)))?.groupValues?.get(2)?.toIntOrNull()
+
+    fun infos(t: String): List<FrameInfo> {
+        val out = ArrayList<FrameInfo>()
+        for (r in ranges(t)) {
+            val raw = t.substring(r.s, r.e)
+            val cap = HDR_NAME.find(raw)?.groupValues?.get(2) ?: ""
+            out.add(FrameInfo(r.idx, cap, intIn(raw, "pic"), intIn(raw, "wait") ?: 0, intIn(raw, "next"), r.s, r.e))
+        }
+        return out
+    }
+
+    fun groupKey(caption: String): String = caption.lowercase().replace(GKEY, "")
+
+    fun group(list: List<FrameInfo>): List<FrameGroup> {
+        val out = ArrayList<FrameGroup>()
+        var curKey: String? = null
+        var buf = ArrayList<FrameInfo>()
+        for (f in list) {
+            val k = groupKey(f.caption)
+            if (k != curKey) {
+                if (buf.isNotEmpty()) out.add(FrameGroup(curKey ?: "", buf))
+                buf = ArrayList()
+                curKey = k
+            }
+            buf.add(f)
+        }
+        if (buf.isNotEmpty()) out.add(FrameGroup(curKey ?: "", buf))
+        return out
+    }
+
+    /**
+     * Ubah (atau hapus bila value null) satu field angka/teks pada bagian utama frame.
+     * Field yang belum ada ditambahkan tepat setelah baris header frame.
+     */
+    fun setTop(raw: String, key: String, value: String?): String {
+        val cut = topLimit(raw)
+        var head = raw.substring(0, cut)
+        val tail = raw.substring(cut)
+        val m = keyRe(key).find(head)
+        if (m != null) {
+            val g = m.groups[2]!!
+            head = if (value == null) {
+                head.substring(0, m.range.first).trimEnd(' ', '\t') + head.substring(m.range.last + 1)
+            } else {
+                head.substring(0, g.range.first) + value + head.substring(g.range.last + 1)
+            }
+        } else if (value != null) {
+            val nl = head.indexOf('\n')
+            head = if (nl >= 0) head.substring(0, nl) + "\n   " + key + ": " + value + head.substring(nl)
+            else head + "\n   " + key + ": " + value
+        }
+        return head + tail
+    }
+
+    /** Ganti caption pada header `<frame> idx caption`. */
+    fun withCaption(raw: String, caption: String): String =
+        HDR_CAP.replace(raw) { m -> m.groupValues[1] + caption }
+
+    /** Baris `kunci nilai` / `kunci: nilai` di header karakter (sebelum frame pertama); baris file(...) tidak ikut. */
+    fun headFields(t: String): List<HeadField> {
+        val fi = t.indexOf("<frame>")
+        val head = t.substring(0, if (fi < 0) t.length else fi)
+        val out = ArrayList<HeadField>()
+        for (m in HEADRE.findAll(head)) {
+            val v = m.groups[2] ?: continue
+            out.add(HeadField(m.groupValues[1], v.value, v.range.first, v.range.last + 1))
+        }
+        return out
+    }
+}
